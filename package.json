{
  "name": "paopao",
  "version": "0.1.0",
  "description": "paopao — 简易命令行聊天 CLI（Ollama + DeepSeek 兼容）",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "paopao": "./dist/bin/paopao.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node ./dist/bin/paopao.js",
    "paopao": "tsx ./bin/paopao.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  }
}
